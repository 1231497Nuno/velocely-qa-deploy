# Copiar para .env.staging (não commitar):
#   cp .env.staging.example .env.staging
#
# Depois edita os valores e arranca com Docker.

# --- Base de dados ---
# Opção A — Mongo no Docker (default do docker-compose.yml):
MONGO_URL=mongodb://mongo:27017
DB_NAME=velocely_staging

# Opção B — MongoDB Atlas (usar com docker-compose.remote.yml):
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# DB_NAME=velocely_staging

# --- Segurança ---
# Gerar: openssl rand -hex 32
JWT_SECRET=change-me-staging-use-openssl-rand

ADMIN_EMAIL=admin@velocely.local
ADMIN_PASSWORD=Admin123!

# Origens do browser que podem chamar a API
CORS_ORIGINS=http://localhost:3080,http://127.0.0.1:3080

# Frontend: vazio = browser usa /api no mesmo host (nginx proxy)
REACT_APP_BACKEND_URL=

# Portas publicadas no teu Mac/servidor
WEB_PUBLISH_PORT=3080
API_PUBLISH_PORT=8000
MONGO_PUBLISH_PORT=27018
