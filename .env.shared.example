# ============================================================
# Velocely — configuração partilhada (Mac + Windows)
# ============================================================
# 1) Copia este ficheiro para .env.shared
# 2) Preenche MONGO_URL (Atlas) e JWT_SECRET
# 3) Usa o mesmo ficheiro nos dois PCs (USB / pasta privada)
#    NÃO publiques este ficheiro na internet.
# 4) Arranque: ver COMO-CORRER.md
# ============================================================

# MongoDB Atlas — cola o URI (aspas obrigatórias por causa do &)
# Exemplo: mongodb+srv://velocely:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL="mongodb+srv://USER:PASSWORD@cluster0.XXXXX.mongodb.net/?retryWrites=true&w=majority"
DB_NAME=velocely

# Segredo JWT — gera UMA vez:  openssl rand -hex 32
# Tem de ser IGUAL no Mac e no Windows
JWT_SECRET=SUBSTITUI-ISTO-pelo-openssl-rand-hex-32

# Conta admin (criada automaticamente no 1.º arranque)
ADMIN_EMAIL=admin@velocely.local
ADMIN_PASSWORD=MudaIsto123!

CORS_ORIGINS="http://localhost:3080,http://127.0.0.1:3080,http://localhost:3000,http://127.0.0.1:3000"
REACT_APP_BACKEND_URL=

WEB_PUBLISH_PORT=3080
API_PUBLISH_PORT=8000
