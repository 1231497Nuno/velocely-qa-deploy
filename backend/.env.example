# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=velocely

# JWT — gerar um valor forte em produção
JWT_SECRET=change-me-in-production

# CORS (origens separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# Utilizador admin criado no arranque APENAS se ainda não existir
# (a password NÃO é alterada em restarts subsequentes)
ADMIN_EMAIL=admin@velocely.local
ADMIN_PASSWORD=Admin123!

# Pasta local para uploads de imagens
UPLOAD_DIR=uploads

# Email / SMTP (necessário para códigos de alteração de password)
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@exemplo.com
# SMTP_TLS=true
# EMAIL_LOGO_URL=https://seu-dominio.com/logo.png
# (URL pública HTTPS — evita CID/anexo; o Gmail do destinatário precisa de URL pública)
